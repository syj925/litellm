FROM ghcr.io/berriai/litellm:v1.106.6@sha256:37e2dafb088a7723beb998590682957386dfc83ffea1848486f8e0e5cfac0b06

COPY runtime-requirements.txt /tmp/retail-runtime-requirements.txt
RUN /app/.venv/bin/python -m ensurepip \
    && /app/.venv/bin/python -m pip install --no-cache-dir --no-deps --require-hashes -r /tmp/retail-runtime-requirements.txt \
    && rm /tmp/retail-runtime-requirements.txt
